PORT=3000
NODE_ENV=production
APP_URL=https://olaslog.com
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MIN_FUNDING_AMOUNT=100

# Rakib Socials API Integration
RAKIB_API_KEY=your_rakib_api_key_here
RAKIB_API_BASE_URL=https://www.rakibsocials.com/api/v1

# BillStack Virtual Bank Account Integration
# Available banks: 9PSB, SAFEHAVEN, PROVIDUS, PALMPAY
BILLSTACK_SECRET_KEY=Bill_Stack-SEC-KEY-your_secret_key_here
BILLSTACK_DEFAULT_BANK=9PSB

# USPhoneVerify API Integration (Instant US SMS Verification)
USPHONEVERIFY_USER=your_usphoneverify_username_or_email
USPHONEVERIFY_API_KEY=your_usphoneverify_api_key
USPHONEVERIFY_USD_RATE=1500
USPHONEVERIFY_MARGIN_PERCENT=25
USPHONEVERIFY_MIN_PRICE=800
